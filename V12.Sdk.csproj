<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pack as a global tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vcsdk</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageId>V12.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Description>V12 SDK — scaffold, build, and package games.</Description>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Templates shipped inside the tool package -->
    <Content Include="templates/**">
      <Pack>true</Pack>
      <PackagePath>content/templates/</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Exclude nested submodule engines -->
    <Compile Remove="libs/**" />
    <Compile Remove="Templates/**" />
  </ItemGroup>

</Project>
