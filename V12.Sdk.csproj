<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pack as a global tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vcsdk</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageId>V12.Sdk</PackageId>
    <Version>0.1.0</Version>
    <Description>V12 SDK — scaffold, build, and package games.</Description>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Scaffolding templates use {name} placeholders and are copied as content,
         never compiled into the tool. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);templates/**;Templates/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Templates shipped inside the tool package -->
    <Content Include="templates/**">
      <Pack>true</Pack>
      <PackagePath>content/templates/</PackagePath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Exclude nested submodule engines and scaffolding templates (they use
         {name} placeholders and are not meant to compile as part of the tool) -->
    <Compile Remove="libs/**" />
    <Compile Remove="Templates/**" />
    <Compile Remove="templates/**" />
    <None Remove="Templates/**" />
    <None Remove="templates/**" />
  </ItemGroup>

  <!--
    The tool package ships the build output, and MSBuild does not delete stale
    copies of Content files. Without this, removing or renaming a template file
    leaves the old copy in bin/ and it is both scaffolded by `new-dotnet` and
    packed into the tool. Re-stage the template tree on every build.
  -->
  <Target Name="RestageTemplates" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="$(OutputPath)templates" />
  </Target>

  <ItemGroup>
    <!-- Packing goes through V12.Pak (the vendored submodule) rather than a
         hand-rolled tar writer, so the SDK, the studio, and the engine all
         produce and read one pak format. -->
    <ProjectReference Include="$(V12PakProject)" />

    <!-- The schema generator reflects over the built-in component assemblies.
         Conditioned so a standalone SDK checkout can still build without the
         sibling engine sources; in that case pass an assemblies directory explicitly. -->
    <ProjectReference Include="$(V12EngineProject)" Condition="Exists('$(V12EngineProject)')" />
    <ProjectReference Include="$(V12BasicProject)" Condition="Exists('$(V12BasicProject)')" />
  </ItemGroup>

  <ItemGroup>
    <!-- Metadata-only reflection: inspect game/engine assemblies without
         executing module initializers or game code. -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>

</Project>
