<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      Game paks are plugins: the generic V12 renderer loads this assembly from
      the packaged .v12pak and runs it as an IV12Gamepack. EnableDynamicLoading
      makes publish copy the project's dependencies next to the assembly.
    -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!--
    V12 Engine References

    Reference the engine the renderer ships, and keep the version in sync:
    a gameplay assembly compiled against a different V12 cannot share component
    type identity with the running host.

    NuGet (recommended):
    <ItemGroup>
      <PackageReference Include="Finite.V12" Version="1.0.0" />
    </ItemGroup>

    Local project reference:
    <ItemGroup>
      <ProjectReference Include="../V12.Monogame/libs/V12.Basic/V12.Basic.csproj" />
    </ItemGroup>
  -->

</Project>
